{
  "name": "mail-fanout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "oauth:check": "node --import=tsx scripts/check-gmail-oauth.ts",
    "trigger": "node --import=tsx scripts/trigger.ts",
    "check": "biome check src scripts tests package.json biome.json",
    "format": "biome format --write src scripts tests package.json biome.json",
    "test": "node --import=tsx tests/index.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "verify": "npm run check && npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
