{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-fanout",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "upload_source_maps": true,
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "PROCESSED_EMAILS"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
